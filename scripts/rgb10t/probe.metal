// Newly authored synthetic probe: adversarial rgb10a2Unorm bilinear rounding sweep.
// All texels/coordinates are generated by probe.swift. In-shader reference is the
// integer candidate model (8-bit half-up weights, exact sum, half-up to n/4092 RGB,
// 85*a with n/4080 alpha); the GPU result is classified against it.
#include <metal_stdlib>
using namespace metal;

struct GP { uint tex_id; uint cell_base; uint near_cap; uint mis_cap; };
constant uint HIST = 16;            // ctr[16..] histogram
constant uint AHIST = 16 + 3 * 257 * 3;

static inline uint chan(uint w, uint c) { return c < 3 ? (w >> (10 * c)) & 1023u : 85u * (w >> 30); }

kernel void grid(texture2d<float, access::sample> t [[texture(0)]], sampler s [[sampler(0)]],
                 constant uint *words [[buffer(0)]], constant GP &p [[buffer(1)]],
                 device const uint *tbl4092 [[buffer(2)]], device const uint *tbl4080 [[buffer(3)]],
                 device atomic_uint *ctr [[buffer(4)]], device uint2 *mis [[buffer(5)]],
                 device uint2 *near [[buffer(6)]], device ushort4 *dump [[buffer(7)]],
                 constant int *dumpSlot [[buffer(8)]],
                 uint gid [[thread_position_in_grid]]) {
    uint cell = p.cell_base + (gid >> 16);
    if (cell >= 225) return;
    uint kx = (gid >> 8) & 255u, ky = gid & 255u;
    uint cx = cell % 15u, cy = cell / 15u;
    float2 uv = float2(float(cx * 256u + 128u + kx), float(cy * 256u + 128u + ky)) / 4096.0f; // exact
    float4 v = t.sample(s, uv, level(0));
    uint w00 = words[cy * 16 + cx], w01 = words[cy * 16 + cx + 1];
    uint w10 = words[(cy + 1) * 16 + cx], w11 = words[(cy + 1) * 16 + cx + 1];
    uint ix = 256u - kx, iy = 256u - ky;
    uint W00 = ix * iy, W01 = kx * iy, W10 = ix * ky, W11 = kx * ky;
    uint id = (p.tex_id << 28) | (cell << 16) | (kx << 8) | ky;
    ushort4 dn;
    for (uint c = 0; c < 4; ++c) {
        uint S = W00 * chan(w00, c) + W01 * chan(w01, c) + W10 * chan(w10, c) + W11 * chan(w11, c);
        uint X = c < 3 ? 4u * S : 16u * S;              // units of 1/65536 output step
        uint fl = X >> 16;
        int eps = int(X & 0xffffu) - 32768;
        float vc = v[c];
        uint nh = uint(rint(vc * (c < 3 ? 4092.0f : 4080.0f)));
        uint lim = c < 3 ? 4092u : 4080u;
        bool ongrid = nh <= lim && (c < 3 ? tbl4092[nh] : tbl4080[nh]) == as_type<uint>(vc);
        if (!ongrid) atomic_fetch_add_explicit(&ctr[2], 1u, memory_order_relaxed);
        dn[c] = ushort(ongrid ? nh : 0xffffu);
        int delta = int(nh) - int(fl);                  // 0 = rounded down, 1 = rounded up
        uint q = (X + 32768u) >> 16;
        uint rec = (c << 30) | ((uint(delta + 512) & 0x3ffu) << 16) | (uint(eps + 32768) & 0xffffu);
        if (!ongrid || nh != q) {
            uint k = atomic_fetch_add_explicit(&ctr[0], 1u, memory_order_relaxed);
            if (k < p.mis_cap) mis[k] = uint2(id, ongrid ? rec : (rec | 0x03ff0000u));
        }
        uint outcome = delta == 0 ? 0u : (delta == 1 ? 1u : 2u);
        if (c < 3) {
            if (eps >= -512 && eps <= 512)
                atomic_fetch_add_explicit(&ctr[HIST + (c * 257u + uint(eps + 512) / 4u) * 3u + outcome], 1u, memory_order_relaxed);
            if (eps >= -48 && eps <= 48) {
                uint k = atomic_fetch_add_explicit(&ctr[1], 1u, memory_order_relaxed);
                if (k < p.near_cap) near[k] = uint2(id, rec);
            }
        } else if (eps >= -512 && eps <= 512) {
            atomic_fetch_add_explicit(&ctr[AHIST + (uint(eps + 512) / 16u) * 3u + outcome], 1u, memory_order_relaxed);
        }
    }
    int slot = dumpSlot[cell];
    if (slot >= 0) dump[uint(slot) * 65536u + (kx << 8) + ky] = dn;
}

kernel void list(texture2d<float, access::sample> t [[texture(0)]], sampler s [[sampler(0)]],
                 constant uint &n [[buffer(0)]], device const float2 *uv [[buffer(1)]],
                 device uint4 *out [[buffer(2)]], uint i [[thread_position_in_grid]]) {
    if (i >= n) return;
    out[i] = as_type<uint4>(t.sample(s, uv[i], level(0)));
}