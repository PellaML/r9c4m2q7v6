// Newly authored synthetic probe: rgb10a2Unorm sampling arithmetic.
// Every value sampled here is generated by probe.swift; no external inputs.
#include <metal_stdlib>
using namespace metal;

// Runtime sampler state, compute, explicit level(0) and implicit-LOD spelling.
kernel void k_float(texture2d<float, access::sample> t [[texture(0)]], sampler s [[sampler(0)]],
                    constant uint &n [[buffer(0)]], device const float2 *uv [[buffer(1)]],
                    device uint4 *o_lvl [[buffer(2)]], device uint4 *o_imp [[buffer(3)]],
                    uint i [[thread_position_in_grid]]) {
    if (i >= n) return;
    float2 c = uv[i];
    o_lvl[i] = as_type<uint4>(t.sample(s, c, level(0)));
    o_imp[i] = as_type<uint4>(t.sample(s, c));
}
kernel void k_half(texture2d<half, access::sample> t [[texture(0)]], sampler s [[sampler(0)]],
                   constant uint &n [[buffer(0)]], device const float2 *uv [[buffer(1)]],
                   device ushort4 *o_lvl [[buffer(2)]], device ushort4 *o_imp [[buffer(3)]],
                   uint i [[thread_position_in_grid]]) {
    if (i >= n) return;
    float2 c = uv[i];
    o_lvl[i] = as_type<ushort4>(t.sample(s, c, level(0)));
    o_imp[i] = as_type<ushort4>(t.sample(s, c));
}

// Constexpr samplers with the same intended state (lod_average not expressible).
constexpr sampler cx_lin(coord::normalized, address::clamp_to_edge, filter::linear, mip_filter::none);
constexpr sampler cx_near(coord::normalized, address::clamp_to_edge, filter::nearest, mip_filter::none);
kernel void k_cx_float(texture2d<float, access::sample> t [[texture(0)]],
                       constant uint &n [[buffer(0)]], device const float2 *uv [[buffer(1)]],
                       device uint4 *o_lin [[buffer(2)]], device uint4 *o_near [[buffer(3)]],
