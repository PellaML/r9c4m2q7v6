// Direct reads of all texels (format conversion reference).
kernel void k_read(texture2d<float, access::read> tf [[texture(0)]],
                   texture2d<half, access::read> th [[texture(1)]],
                   device uint4 *of [[buffer(0)]], device ushort4 *oh [[buffer(1)]],
                   uint2 p [[thread_position_in_grid]]) {
    if (p.x >= tf.get_width() || p.y >= tf.get_height()) return;
    uint i = p.y * tf.get_width() + p.x;
    of[i] = as_type<uint4>(tf.read(p));
    oh[i] = as_type<ushort4>(th.read(p));
}

// Fragment path: implicit LOD with real (arbitrary) quad derivatives.
struct VOut { float4 position [[position]]; };
vertex VOut tri(uint vid [[vertex_id]]) {
    float2 p = float2((vid == 1) ? 3.0 : -1.0, (vid == 2) ? 3.0 : -1.0);
    VOut o; o.position = float4(p, 0.0, 1.0); return o;
}
fragment float4 f_float(VOut in [[stage_in]], texture2d<float, access::sample> t [[texture(0)]],
                        sampler s [[sampler(0)]], constant uint &n [[buffer(0)]],
                        device const float2 *uv [[buffer(1)]], device uint4 *o [[buffer(2)]],
                        constant uint &gw [[buffer(3)]]) {
    uint2 xy = uint2(in.position.xy);
    uint i = xy.y * gw + xy.x;
    float4 v = t.sample(s, uv[min(i, n - 1)]);
    if (i < n) o[i] = as_type<uint4>(v);
    return float4(0.0);
}
fragment half4 f_half(VOut in [[stage_in]], texture2d<half, access::sample> t [[texture(0)]],
                      sampler s [[sampler(0)]], constant uint &n [[buffer(0)]],
                      device const float2 *uv [[buffer(1)]], device ushort4 *o [[buffer(2)]],
                      constant uint &gw [[buffer(3)]]) {
    uint2 xy = uint2(in.position.xy);
    uint i = xy.y * gw + xy.x;
    half4 v = t.sample(s, uv[min(i, n - 1)]);
    if (i < n) o[i] = as_type<ushort4>(v);
    return half4(0.0h);
}
