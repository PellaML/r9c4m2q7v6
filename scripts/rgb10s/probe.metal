}
kernel void k_cx_half(texture2d<half, access::sample> t [[texture(0)]],
                      constant uint &n [[buffer(0)]], device const float2 *uv [[buffer(1)]],
                      device ushort4 *o_lin [[buffer(2)]], device ushort4 *o_near [[buffer(3)]],
