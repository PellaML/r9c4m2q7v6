#pragma once
#include <metal_stdlib>
using namespace metal;

struct Coordinate { uint x, y, z; }; // 12-byte packed scalar record, not uint3.
struct Sample { uint4 rgba; uint stamp, reserved0, reserved1, reserved2; };
struct Parameters {
    uint count, width, sampler_index, token;
    float bias_value;
    uint reserved0, reserved1, reserved2;
};
struct Raster { float4 position [[position]]; };

vertex Raster probe_vertex(uint vertex_id [[vertex_id]]) {
    const float2 positions[3] = {float2(-1, -1), float2(3, -1), float2(-1, 3)};
    Raster r;
    r.position = float4(positions[vertex_id], 0, 1);
    return r;
}

inline float3 probe_coordinate(device const Coordinate *coordinates, uint index) {
    Coordinate c = coordinates[index];
    return as_type<float3>(uint3(c.x, c.y, c.z));
}

inline void probe_store(device Sample *output, uint index, uint token, float4 value) {
    output[index].rgba = as_type<uint4>(value);
    output[index].stamp = token ^ index ^ 0x9e3779b9u;
    output[index].reserved0 = 0;
    output[index].reserved1 = 0;
    output[index].reserved2 = 0;
}
